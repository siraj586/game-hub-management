# Copy this file to .env and adjust. .env is never committed.

# Local development: keep True. On the shop PC / server: set False.
DEBUG=True

# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma-separated. Add the shop PC's LAN IP or your domain when other devices connect.
GAMEHUB_ALLOWED_HOSTS=localhost,127.0.0.1
GAMEHUB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set True only when the app is served over HTTPS.
GAMEHUB_HTTPS=False

# Login attempts allowed per IP address.
GAMEHUB_LOGIN_RATE=10/min
